# saaga-social-flow environment configuration
#
# You do not have to edit this by hand: open the app and use the Settings tab,
# which writes this same file, tells you which one it is editing, and can test
# each key against the live service. This copy is the reference.
#
#   cp .env.example .env
#
# On a machine running an installed release there is no checkout, and Settings
# writes ~/.stream-recorder/.env instead. Either file is read at startup; a
# value already exported in your shell beats both.

# ============================================================ REQUIRED

# === Models ===
# Thumbnail art, figure blurbs, notes and social copy. Nothing that writes text
# or draws an image works without this.
#
# One key covers every model, image models included — thumbnails route to
# google/gemini-3.1-flash-image THROUGH OpenRouter, so there is no separate
# Gemini key to set.
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# === Buffer social scheduling ===
# Building and sending the schedule.
# Generate at: https://publish.buffer.com/settings/api
BUFFER_API_KEY=

# === Media upload ===
# Where renders are uploaded so Buffer has a public video URL to attach.
# The AWS credentials themselves come from your AWS profile, not from here.
S3_BUCKET=

# === Blog / CMS ===
# Both come from the team file, dev.sops.env, which sets the production CMS,
# https://cms.saagasolve.com. That is also the code's default when the URL is
# unset. Set either here only to override the team on this one machine.
#STRAPI_API_URL=https://cms.saagasolve.com
#
# Strapi Admin → Settings → API Tokens, on the CMS above. Needs find, create
# and update on video-post, create on upload, and find on authors and
# categories — a read-only token fails at publish time, not at save time.
#STRAPI_API_TOKEN=

# === YouTube ===
# Uploading the render and setting its thumbnail.
#
# An OAuth client of type "Desktop app" from the Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# The client is shared across the team; each person signs in as themselves
# with Connect on the YouTube tab.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ============================================================ OPTIONAL

# Transcription. Unset, chapters still record and transcripts are written as
# skipped. Get one at: https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=

# A safety catch: set it and an upload aborts if the signed-in account is not
# this channel. Leave blank to accept whichever account is signed in.
# YOUTUBE_CHANNEL_ID=

# Resolved automatically on a single-workspace Buffer account. Set it if you
# belong to more than one, or posts land in the wrong workspace.
# BUFFER_ORG_ID=

# Twitter handle used as context when writing posts.
# BUFFER_TWITTER_HANDLE=@your_handle

# The site blog figures are linked from, e.g. https://saagasolve.com
BLOG_PUBLIC_BASE=http://localhost:3000

# === Paths and runners ===
# Path to thumbnail references (figures used for generation context)
# THUMBNAIL_REFERENCES=/path/to/references

# Path to Node.js binary for the content workflow runner
# CONTENT_NODE_BIN=/usr/local/bin/node

# Workflow runner command (if using an external runner)
# CONTENT_WORKFLOW_RUNNER=/path/to/runner

# Points this app's OAuth token store at the same sqlite file as the Python
# server, instead of the default ~/.saaga/auth.db
# SAAGA_AUTH_DB_URL=sqlite:///absolute/path/to/auth.db

# The screencast checkout the S3 uploader runs from.
# SCREENCAST_HOME=/path/to/screencast

# How many renders run at once. Defaults to a value derived from the machine.
# SCREENCAST_RENDER_WORKERS=2

# === Logging ===
# off, error, warn, info, debug, trace
RUST_LOG=info

# === Development ===
# Test image path for face detection tests (development only)
# FACE_TEST_IMAGE=/path/to/test/image.png
