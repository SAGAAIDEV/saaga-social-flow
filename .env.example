# saaga-social-flow environment configuration
# Copy this to .env and fill in your actual values

# === LLM / Thumbnail Generation ===
# OpenRouter API key for blurb generation and thumbnail descriptions
# Get one at: https://openrouter.ai/
OPENROUTER_API_KEY=sk_test_...

# === Buffer Social Scheduling ===
# Buffer API key for scheduling posts across social platforms
# Generate at: https://publish.buffer.com/settings/api
BUFFER_API_KEY=...

# Optional: Twitter handle for Buffer scheduling context
BUFFER_TWITTER_HANDLE=@your_handle

# === Blog / CMS Integration ===
# Strapi CMS API URL (e.g., http://localhost:1337 for local development)
STRAPI_API_URL=http://localhost:1337

# Strapi API token (generated in Strapi admin)
# Settings → API Tokens → Create new token with content-type access
STRAPI_API_TOKEN=...

# Public base URL for blog figures (used in Strapi content)
# Example: https://saagasolve.com or http://localhost:3000
BLOG_PUBLIC_BASE=http://localhost:3000

# === Optional: Content Generation ===
# Path to thumbnail references (figures used for generation context)
# THUMBNAIL_REFERENCES=/path/to/references

# Path to Node.js binary for content workflow runner
# CONTENT_NODE_BIN=/usr/local/bin/node

# Workflow runner command (if using external runner)
# CONTENT_WORKFLOW_RUNNER=/path/to/runner

# === Logging ===
# Log level: off, error, warn, info, debug, trace
RUST_LOG=info

# === Development ===
# Test image path for face detection tests (development only)
# FACE_TEST_IMAGE=/path/to/test/image.png
